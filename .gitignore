# Data (large and private). Keep only the empty folder layout (.gitkeep files),
# so a fresh clone on the sensor has the same folders.
data/**
!data/**/
!data/**/.gitkeep

# Old code and files we no longer use (top-level folder only; docs/archive/ is tracked)
/archive/

# Models and captures (large files)
*.pkl
*.joblib
*.pcap
*.pcapng
*.log
*.parquet

# CSV files are usually data. Result tables in reports/ ARE kept
# (for example reports/dataset_manifest.csv in Step 7).
*.csv
!reports/**/*.csv

# Local databases (they can hold user names and password hashes)
*.db
*.sqlite
*.sqlite3
instance/

# Binaries and archives (not source code)
*.exe
*.msi
*.zip
*.7z
*.tar
*.gz

# Secrets and real lab settings
.env
.env.*
!.env.example
config/settings.yaml

# Dependencies, caches and build output
node_modules/
my-app/build/
__pycache__/
*.pyc
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Editor and OS files
.vscode/
.idea/
Thumbs.db
desktop.ini
image/
.DS_Store




# Virtual lab (D-053): keys, Zeek output and backend logs stay on this PC
lab_virtual/keys/*
!lab_virtual/keys/.gitignore
lab_virtual/zeek_logs/*
!lab_virtual/zeek_logs/.gitignore
lab_virtual/ids_backend.log
