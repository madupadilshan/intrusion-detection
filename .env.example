# Secret settings ONLY (proposal Section 3.6).
# Copy this file to .env and fill in real values there. Never commit .env.
# Lab IP addresses, the allowlist and thresholds go in config/settings.yaml, not here.

# MongoDB
MONGO_URI=
DB_NAME=iot_ids_db

# Login (Step 24). Use a long random value, e.g. python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
FLASK_SECRET_KEY=

# Router adapter for passive mode (Step 33)
# Primary variable names (or use ROUTER_SSH_* aliases below)
ROUTER_HOST=
ROUTER_PORT=22
ROUTER_USER=root
ROUTER_KEY_FILE=

# Backwards-compatible aliases:
ROUTER_SSH_HOST=
ROUTER_SSH_USER=
ROUTER_SSH_KEY_PATH=
