# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/
DB_NAME=iot_ids_db

# Flask Server Configuration
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=change-this-to-a-secure-random-secret
JWT_SECRET=change-this-to-a-secure-random-jwt-secret

# Sensor & Network Settings
INTERFACE=eth0
LAB_SUBNET=192.168.8.0/24
ADMIN_IP=192.168.8.100
NVR_IP=192.168.8.10
GATEWAY_IP=192.168.8.1

